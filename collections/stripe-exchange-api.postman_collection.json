          "name": "Stripe Get   Exchange Rates",
          "request": {
            "name": "Stripe Get   Exchange Rates",
            "description": {
              "content": "<p>Returns a list of objects that contain the rates at which foreign currencies are converted to one another. Only shows the currencies for which Stripe supports.</p>",
              "type": "text/plain"
            },
