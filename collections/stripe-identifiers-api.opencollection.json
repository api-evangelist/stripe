        {
          "info": {
            "name": "Stripe Post   Customers Customer Subscriptions Subscription Exposed Id",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.stripe.com/v1/customers/:customer/subscriptions/:subscription_exposed_id",
            "params": [
              {
                "name": "customer",
